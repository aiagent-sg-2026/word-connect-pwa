{
  "name": "word-connect-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "smoke": "node scripts/smoke.mjs",
    "dictionary:build": "node scripts/dictionary-build.mjs",
    "score:eval": "node scripts/score-eval.mjs",
    "content:generate": "node scripts/content-generate.mjs",
    "content:verify": "node scripts/content-verify.mjs",
    "golden:queue": "node scripts/golden.mjs queue",
    "golden:review:export": "node scripts/golden.mjs review:export",
    "golden:review:validate": "node scripts/golden.mjs review:validate",
    "golden:review:import": "node scripts/golden.mjs review:import",
    "golden:adjudication:validate": "node scripts/golden.mjs adjudication:validate",
    "golden:status": "node scripts/golden.mjs status",
    "golden:publish": "node scripts/golden.mjs publish",
    "golden:publish:draft": "node scripts/golden.mjs publish --draft",
    "golden:eval": "node scripts/golden.mjs eval"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "latest",
    "idb": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "fake-indexeddb": "latest",
    "jsdom": "latest",
